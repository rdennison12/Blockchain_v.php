<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title|default('Blockchain App') }} | Blockchain Project</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body class="d-flex flex-column min-vh-100 bg-body-tertiary">
    <header class="bg-dark" data-bs-theme="dark">
        <nav class="container navbar navbar-dark py-3 gap-3" aria-label="Main navigation">
            <a class="navbar-brand fw-bold" href="/">Blockchain <span class="text-info">Project</span></a>
            <div class="navbar-nav flex-row flex-wrap gap-3">
                <a class="nav-link{% if active_page|default('') == 'home' %} active{% endif %}" href="/"{% if active_page|default('') == 'home' %} aria-current="page"{% endif %}>Home</a>
                <a class="nav-link" href="/blockchain/index">Chain API</a>
                <a class="nav-link" href="/blockchain/validate-chain">Validate API</a>
            </div>
        </nav>
    </header>
    <main class="container flex-grow-1 py-5">
        {% block content %}{% endblock %}
    </main>
    <footer class="bg-dark text-light small">
        <div class="container d-flex justify-content-between flex-wrap gap-3 py-4">
            <p class="mb-0">&copy; {{ 'now'|date('Y') }} Blockchain Project</p>
            <p class="mb-0">An educational blockchain, not a cryptocurrency.</p>
        </div>
    </footer>
</body>
</html>
